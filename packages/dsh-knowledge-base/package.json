{
  "name": "dsh-knowledge-base",
  "version": "0.3.0",
  "description": "Project knowledge base for DeepSeek Harness: build a deterministic lexical index over a repository's own specifications, decisions, delivery trail, documentation and code, then answer project questions with path:line citations — no embeddings, no network, named gaps for everything the index does not cover.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "knowledge-base",
    "retrieval",
    "bm25",
    "citations"
  ],
  "dependencies": {
    "dsh-eng-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1-0"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
