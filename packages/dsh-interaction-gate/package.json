{
  "name": "dsh-interaction-gate",
  "version": "0.1.0",
  "description": "Interaction layer for DeepSeek Harness's engineering suite: ask / notify / progress over pluggable channels, with one-shot tokens, a decision ledger and fail-closed timeouts — the suite's own seam for the decisions that need a human, so a phone or headless session can answer them.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "interaction",
    "approval",
    "im"
  ],
  "dependencies": {
    "dsh-eng-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.1.8-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.1.8-0"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
