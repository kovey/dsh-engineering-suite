{
  "name": "dsh-coverage-gate",
  "version": "0.1.0",
  "description": "Test-effectiveness gate for DeepSeek Harness: turn coverage reports and repeated test runs into deterministic PASS/BLOCK verdicts — total coverage, coverage of the lines this change ADDED, and whether any test is flaky.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "coverage",
    "flaky",
    "gate"
  ],
  "dependencies": {
    "dsh-eng-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
