{
  "name": "dsh-standards-gate",
  "version": "0.1.0",
  "description": "Code-standards gate for DeepSeek Harness: measure a target repository against its declared structural standards (file/function size, nesting, branch size, parameter count, exported surface, module dependency direction) and turn the result into a deterministic gate with a baseline ratchet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "standards",
    "architecture",
    "gate"
  ],
  "dependencies": {
    "dsh-eng-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
